{
    "name": "s1k3/bangladate",
    "description": "Laravel Library for converting English date to corresponding Bangla Date",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Robin Khan",
            "email": "sk118420@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "S1K3\\Bangla\\Date\\": "src/"
        },
        "files": [
            "src/helper/bangla_date.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "S1K3\\Bangla\\Date\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "S1K3\\Bangla\\Date\\BanglaDateServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
